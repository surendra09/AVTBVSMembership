# =============================================================================
# AVTBVS Membership – environment configuration.  Copy to .env and fill in.
# NEVER commit the real .env file.
# =============================================================================

ENVIRONMENT=production            # development | test | production
PUBLIC_APP_URL=https://members.example.org
CORS_ORIGINS=https://members.example.org

# --- MySQL (used by docker-compose) -----------------------------------------
MYSQL_DATABASE=avtbvs
MYSQL_USER=avtbvs
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
# For running the API outside Docker:
# DATABASE_URL=mysql+pymysql://avtbvs:PASSWORD@127.0.0.1:3306/avtbvs?charset=utf8mb4

# --- Secrets (generate fresh values – see README "Generating secrets") --------
SECRET_KEY=
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# --- Cookies / tokens ----------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Organisation (pre-filled from the official form; confirm before go-live) --
ORG_FULL_NAME=Ayira Vaisyar Telugu Beri Vysya Sabha
ORG_ABBREVIATION=AVTBVS
ORG_REGISTRATION=Regd. No. 101/1955
ORG_ADDRESS=28, (Old No. 4), Kalappachari Street, Park Town, Chennai - 600 003
ORG_PHONE=044-25330821
ORG_EMAIL=avtbvsabha.1955@gmail.com

# --- Membership number format (MUST be confirmed with the Sabha office) ------
# Placeholders: {seq} {year} {yy} {prefix}; Python format specs allowed, e.g. {seq:05d}
MEMBERSHIP_NUMBER_TEMPLATE={seq}
MEMBERSHIP_NUMBER_PREFIX=
MEMBERSHIP_SEQUENCE_START=1
MEMBERSHIP_SEQUENCE_PER_YEAR=false

# --- Business rules ------------------------------------------------------------
MINIMUM_AGE_YEARS=18
EDIT_PERMISSION_HOURS=24
REQUIRE_INTRODUCER_SIGNATURE=false
INTRODUCER_MUST_BE_REGISTERED=false
REQUIRE_VERIFIED_CONTACT_FOR_SUBMISSION=true

# --- File uploads ----------------------------------------------------------------
MAX_PHOTO_BYTES=2097152
MAX_DOCUMENT_BYTES=5242880

# --- Email -----------------------------------------------------------------------
EMAIL_PROVIDER=smtp               # console (development) | smtp
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=AVTBVS Membership <no-reply@example.org>

# --- SMS ------------------------------------------------------------------------
SMS_PROVIDER=msg91                # console (development) | twilio | msg91
SMS_DEFAULT_COUNTRY_CODE=+91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_FLOW_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

NOTIFICATION_MAX_ATTEMPTS=5
