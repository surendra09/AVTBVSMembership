# Host-level Nginx (on the server, outside Docker) terminating HTTPS with Let's Encrypt.
#   sudo apt install nginx certbot python3-certbot-nginx
#   sudo certbot --nginx -d members.example.org
# Then forward everything to the web container published on 127.0.0.1:8080.

server {
    listen 80;
    server_name members.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name members.example.org;

    ssl_certificate     /etc/letsencrypt/live/members.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/members.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
